# Hosted generation settings for the Freefield server. Copy these names into your private .env.
# On GitHub, use the freefield-hosted environment's variables and secrets for workflows that need them.

# ComfyUI gateway endpoint and the matching gateway token.
COMFY_BASE_URL=https://YOUR-WORKSPACE--freefield-serve.modal.run
FREEFIELD_TOKEN=

# Hosted Gemini and GPT Image credentials.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Veo on Google Cloud. The Freefield server also needs Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
